{
  "name": "@local/douyin-kb",
  "version": "1.3.0",
  "private": true,
  "description": "一个简单的人工提供抖音链接（可通过抖音PC客户端获得），由本插件自动将视频内容转化文字记录，并自动导入到Obsidian中，适用于harness、个人知识库搭建初学者上手。",
  "keywords": [
    "dsh-plugin",
    "douyin",
    "obsidian",
    "speech-to-text",
    "sensevoice",
    "sherpa-onnx"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KunWu1980/dsh-douyin-kb.git"
  },
  "homepage": "https://github.com/KunWu1980/dsh-douyin-kb#readme",
  "bugs": {
    "url": "https://github.com/KunWu1980/dsh-douyin-kb/issues"
  },
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "assets/douyin_kb.py",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-commands"
      ]
    }
  }
}
